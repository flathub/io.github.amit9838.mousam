{
    "app-id": "io.github.amit9838.mousam",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "mousam",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "cleanup-commands": [
        "python3 -m compileall -f --invalidation-mode=unchecked-hash /app"
    ],
    "modules": [
        "data/dependencies/python3-requests.json",
        {
            "name": "mousam",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/amit9838/mousam.git",
                    "commit": "71d7ff4e7e3db96ef438360a2f75ae122cbbe19d"
                }
            ]
        }
    ]
}