{
    "app-id": "io.github.amit9838.mousam",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "mousam",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup-commands": [
        "python3 -m compileall -f --invalidation-mode=unchecked-hash /app"
    ],
    "modules": [
        "python3-requests.json",
        {
            "name": "mousam",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/amit9838/mousam.git",
                    "tag": "v3.1.0",
                    "commit": "97b81b8585e2a505b48ae362431737e88fe1d9d3"
                }
            ]
        }
    ]
}
